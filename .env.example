# RUDRA configuration — copy to `.env` and fill in. NEVER commit your real .env.

# --- Brain (Claude) ---
ANTHROPIC_API_KEY=
RUDRA_MODEL=claude-opus-4-8

# --- Identity ---
RUDRA_NAME=Rudra
RUDRA_WAKE_WORD=rudra

# --- MQTT bus ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Set true to make a missing broker a hard error (default: fall back to stub).
RUDRA_BUS_REQUIRED=false

# --- PC agent (runs on the machine you control) ---
RUDRA_PC_ID=main-pc
RUDRA_SEARCH_ROOT=~

# --- IoT agent (Home Assistant bridge) ---
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# --- Voice (hybrid) ---
RUDRA_VOICE_ENABLED=false
RUDRA_WAKE_MODEL_PATH=
RUDRA_WAKE_THRESHOLD=0.5
RUDRA_STT=faster-whisper
RUDRA_STT_MODEL=base.en
RUDRA_TTS=elevenlabs
RUDRA_TTS_VOICE_ID=Adam
TTS_API_KEY=
RUDRA_SAMPLE_RATE=16000

# --- Storage / server ---
RUDRA_DB=rudra.db
RUDRA_HOST=0.0.0.0
RUDRA_PORT=8080
RUDRA_LOG_LEVEL=INFO
