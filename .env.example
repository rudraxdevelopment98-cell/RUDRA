# RUDRA configuration — copy to `.env` and fill in. NEVER commit your real .env.

# --- Brain ---
# Which LLM provider to use: "gemini" (default, free tier) or "anthropic".
RUDRA_LLM_PROVIDER=gemini

# Gemini — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
RUDRA_GEMINI_MODEL=gemini-2.5-flash

# Claude — only needed if RUDRA_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
RUDRA_MODEL=claude-opus-4-8

# --- Identity ---
RUDRA_NAME=Rudra
RUDRA_WAKE_WORD=rudra

# --- MQTT bus ---
# Local dev (e.g. `docker compose up` Mosquitto): leave as-is.
# Shared/cloud broker (e.g. HiveMQ Cloud) so the deployed brain and your
# devices can reach each other: set MQTT_HOST to the cluster host, MQTT_PORT
# to 8883, MQTT_TLS=true, and fill in MQTT_USERNAME/MQTT_PASSWORD.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# Set true to make a missing broker a hard error (default: fall back to stub).
RUDRA_BUS_REQUIRED=false

# --- PC agent (runs on the machine you control) ---
RUDRA_PC_ID=main-pc
RUDRA_SEARCH_ROOT=~

# --- IoT agent (Home Assistant bridge) ---
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# --- Voice (hybrid) ---
RUDRA_VOICE_ENABLED=false
RUDRA_WAKE_MODEL_PATH=
RUDRA_WAKE_THRESHOLD=0.5
RUDRA_STT=faster-whisper
RUDRA_STT_MODEL=base.en
RUDRA_TTS=elevenlabs
RUDRA_TTS_VOICE_ID=Adam
TTS_API_KEY=
RUDRA_SAMPLE_RATE=16000

# --- Storage / server ---
RUDRA_DB=rudra.db
# Bind to localhost so nothing on your network can reach RUDRA directly.
# Remote access should go through a secure tunnel (Tailscale/Cloudflare),
# NOT by binding to 0.0.0.0 and opening a port.
RUDRA_HOST=127.0.0.1
RUDRA_PORT=8080
RUDRA_LOG_LEVEL=INFO

# --- Security ---
# Password to unlock the dashboard + API. REQUIRED before exposing RUDRA over a
# tunnel or network. Generate a strong one, e.g.:
#   python3 -c "import secrets;print(secrets.token_urlsafe(24))"
RUDRA_AUTH_TOKEN=
